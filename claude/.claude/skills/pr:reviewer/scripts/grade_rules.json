{
  "_comment": "pr:reviewer 등급 규칙. 파일 경로(path_rules)와 추가된 diff 라인(content_rules)에 정규식을 적용한다. 파일 등급은 매칭된 규칙 중 최고 등급(A > B > C)이고, 매칭이 없으면 default_grade. 등급 의미: A=이해 필수(리뷰어 모드), B=검증 장치가 대신함(요약 모드), C=기계적(요약 모드). 규칙을 고칠 때는 references/grade-rules.md의 판정 원리와 함께 고친다.",
  "default_grade": "B",
  "default_reason": "미분류 경로: 검증 장치(CI/테스트) 존재 여부로 판단한다",
  "path_rules": [
    {
      "id": "lockfile",
      "grade": "C",
      "pattern": "(^|/)(pnpm-lock\\.yaml|package-lock\\.json|yarn\\.lock|Cargo\\.lock|poetry\\.lock|go\\.sum|[^/]*\\.lockfile)$",
      "reason": "잠금 파일: 도구가 생성하고 CI가 검증한다"
    },
    {
      "id": "formatter-config",
      "grade": "C",
      "pattern": "(^|/)(\\.prettierrc[^/]*|\\.editorconfig|\\.oxlintrc[^/]*|eslint\\.config\\.[^/]+|\\.eslintrc[^/]*|biome\\.json|\\.ktlint[^/]*|\\.gitignore|\\.gitattributes)$",
      "reason": "포맷·린트 설정: 동작이 아니라 표기에만 영향"
    },
    {
      "id": "vendored",
      "grade": "C",
      "pattern": "(^|/)(styles/tokens|vendor|node_modules|third_party)/",
      "reason": "vendored 산출물: 원본 그대로 교체하며 손으로 고치지 않는다"
    },
    {
      "id": "snapshot",
      "grade": "C",
      "pattern": "(^|/)__snapshots__/|\\.snap$",
      "reason": "테스트 스냅샷: 테스트 실행이 곧 검증"
    },
    {
      "id": "binary-asset",
      "grade": "C",
      "pattern": "\\.(png|jpe?g|gif|svg|ico|webp|woff2?|ttf|otf|eot)$",
      "reason": "정적 자산: 로직 없음"
    },
    {
      "id": "general-doc",
      "grade": "C",
      "pattern": "\\.(md|mdx|txt|rst)$",
      "reason": "일반 문서: 결정 문서(ADR/PRD/context)는 별도 규칙이 A로 올린다"
    },
    {
      "id": "changelog",
      "grade": "C",
      "pattern": "(^|/)(CHANGELOG|HISTORY)[^/]*$",
      "reason": "변경 이력 기록"
    },
    {
      "id": "ts-source",
      "grade": "B",
      "pattern": "(^|/)src/.*\\.(ts|tsx|js|jsx|css)$",
      "reason": "TS 소스: pnpm check(포맷+린트+토큰+테스트+빌드)가 검증 장치"
    },
    {
      "id": "jvm-source",
      "grade": "B",
      "pattern": "(^|/)src/main/(kotlin|java)/",
      "reason": "JVM 소스: make check(ktlint+ArchitectureRulesTest+테스트)가 검증 장치"
    },
    {
      "id": "test-code",
      "grade": "B",
      "pattern": "(\\.test\\.|\\.spec\\.|(^|/)tests?/|(^|/)src/test/|_test\\.go$|(^|/)test_[^/]+\\.py$)",
      "reason": "테스트 코드: 실행 결과가 곧 검증"
    },
    {
      "id": "python-source",
      "grade": "B",
      "pattern": "\\.py$",
      "reason": "파이썬 소스: 테스트·CI 존재 여부로 판단"
    },
    {
      "id": "shell-script",
      "grade": "B",
      "pattern": "\\.(sh|bash|zsh)$",
      "reason": "셸 스크립트: 내용 규칙(파괴적 명령)이 A로 올릴 수 있다"
    },
    {
      "id": "build-tooling",
      "grade": "B",
      "pattern": "(^|/)(Dockerfile[^/]*|Makefile|compose\\.ya?ml|docker-compose[^/]*\\.ya?ml|package\\.json|build\\.gradle(\\.kts)?|settings\\.gradle(\\.kts)?|pyproject\\.toml|tsconfig[^/]*\\.json|next\\.config\\.[^/]+|vitest\\.config\\.[^/]+|vite\\.config\\.[^/]+)$",
      "reason": "빌드·로컬 스택 설정: CI 빌드가 검증 장치"
    },
    {
      "id": "terraform",
      "grade": "A",
      "pattern": "\\.(tf|tfvars|hcl)$|(^|/)terraform/",
      "flags": [
        "prod"
      ],
      "reason": "IaC: apply가 클라우드 리소스를 직접 바꾸며 plan 출력을 읽어야 영향이 보인다"
    },
    {
      "id": "gitops-manifest",
      "grade": "A",
      "pattern": "\\.(jsonnet|libsonnet)$|^src/[^/]+/[^/]+/.*\\.ya?ml$|(^|/)(base|overlays|envs?|environments)/.*\\.ya?ml$|(^|/)kustomization\\.ya?ml$",
      "reason": "GitOps 매니페스트: 머지 즉시 ArgoCD가 동기화하므로 머지가 곧 배포"
    },
    {
      "id": "helm-chart",
      "grade": "A",
      "pattern": "(^|/)Chart\\.ya?ml$|(^|/)templates/.*\\.(ya?ml|tpl)$",
      "reason": "차트 정의·템플릿: 소비하는 모든 서비스에 전파된다"
    },
    {
      "id": "argocd",
      "grade": "A",
      "pattern": "(^|/)argo-?cd/|(^|/)applicationsets?/|(^|/)application[^/]*\\.ya?ml$|(^|/)appproject[^/]*\\.ya?ml$",
      "reason": "ArgoCD 앱 정의: 동기화 대상·순서 자체를 바꾼다"
    },
    {
      "id": "observability-pipeline",
      "grade": "A",
      "pattern": "\\.(alloy|river)$|(^|/)(alloy|loki|victoria-?metrics|vmagent|vmalert|vmsingle|vmcluster|grafana|tempo|pyroscope|otel|opentelemetry|observability|alerting|alerts?|alert-?rules?|recording-?rules?)/|(^|/)[^/]*(alert|rules?|relabel|scrape)[^/]*\\.ya?ml$",
      "flags": [
        "silent_failure"
      ],
      "reason": "관측 파이프라인: 규칙이 틀려도 파드는 Healthy이고 데이터만 사라진다. 발견 장치 자체의 장애"
    },
    {
      "id": "db-migration",
      "grade": "A",
      "pattern": "(^|/)db/migrations?/|(^|/)migrations?/.*\\.(sql|py|kt|ts|js)$|(^|/)V\\d+__[^/]+\\.sql$|(^|/)alembic/",
      "reason": "스키마 마이그레이션: Flyway가 소유하며 적용 순서가 있다. 파괴적 DDL은 내용 규칙이 one_way_door를 붙인다"
    },
    {
      "id": "ci-workflow",
      "grade": "A",
      "pattern": "^\\.github/(workflows|actions)/|(^|/)\\.gitlab-ci\\.ya?ml$|(^|/)Jenkinsfile[^/]*$|(^|/)\\.circleci/",
      "reason": "CI는 다른 변경의 검증 장치이므로 자기 자신을 검증할 장치가 없다"
    },
    {
      "id": "decision-doc",
      "grade": "A",
      "pattern": "(^|/)(docs/adr|adr|decisions?|llm/prd|llm/context|rfcs?)/",
      "flags": [
        "decision"
      ],
      "reason": "결정 문서: 여기 적힌 것이 이후 모든 구현의 전제가 된다"
    },
    {
      "id": "security-surface",
      "grade": "A",
      "pattern": "(^|/)(keycloak|oidc|oauth|auth[nz]?|rbac|iam|secrets?|external-secrets|sealed-secrets|kyverno|gatekeeper|cert-manager|network-?polic(y|ies)|polic(y|ies))/|(^|/)[^/]*(rbac|secret|iam|clusterrole|rolebinding|networkpolicy|serviceaccount|cors|csp)[^/]*\\.(ya?ml|json|kt|ts|py)$",
      "flags": [
        "security"
      ],
      "reason": "권한·노출 표면: 넓어져도 에러가 나지 않고 좁아지면 뒤늦게 403이 난다"
    },
    {
      "id": "api-contract",
      "grade": "A",
      "pattern": "(^|/)(openapi|swagger|proto|schemas?)/|\\.(proto|graphql|avsc)$|(^|/)openapi[^/]*\\.(ya?ml|json)$|(^|/)src/types/|(^|/)src/data/|(^|/)web/src/main/",
      "flags": [
        "contract"
      ],
      "reason": "API 계약: 프론트·백엔드 CI가 서로를 모르므로 배포 순서를 사람이 지켜야 한다"
    },
    {
      "id": "runtime-config",
      "grade": "A",
      "pattern": "(^|/)application[^/]*\\.(ya?ml|properties)$|(^|/)\\.env(\\.[^/]+)?$|(^|/)config/[^/]*\\.(ya?ml|toml|json)$",
      "reason": "런타임 설정: 테스트가 덮지 않는 값이 많고 환경마다 다르게 읽힌다"
    }
  ],
  "content_rules": [
    {
      "id": "sql-destructive",
      "grade": "A",
      "applies_to": "\\.sql$|(^|/)(db/)?migrations?/|(^|/)alembic/|(^|/)V\\d+__",
      "pattern": "(?i)\\b(DROP\\s+(TABLE|COLUMN|INDEX|SCHEMA)|TRUNCATE|DELETE\\s+FROM|ALTER\\s+TABLE\\s+\\S+\\s+DROP|drop_table|drop_column|drop_index)\\b",
      "flags": [
        "one_way_door"
      ],
      "reason": "파괴적 DDL/DML: 되돌릴 수 없는 데이터 변경"
    },
    {
      "id": "relabel-drop-keep",
      "grade": "A",
      "applies_to": "\\.(alloy|river|ya?ml|libsonnet|jsonnet)$",
      "pattern": "action\\s*[=:]\\s*\"?(drop|keep|labeldrop|labelkeep|hashmod)\"?|stage\\.(drop|match|sampling)|drop_entries|(^|[^a-z_])drop\\s*\\{",
      "flags": [
        "silent_failure"
      ],
      "reason": "라인·시리즈 버림 규칙: 넓게 매칭되면 데이터가 조용히 사라진다"
    },
    {
      "id": "k8s-runtime-knob",
      "grade": "A",
      "applies_to": "\\.(ya?ml|jsonnet|libsonnet)$",
      "pattern": "^\\s*(replicas|image|tag|limits|requests|minAvailable|maxUnavailable|minReplicas|maxReplicas|terminationGracePeriodSeconds|nodeSelector|tolerations)\\s*[:=]",
      "flags": [
        "runtime"
      ],
      "reason": "런타임 노브: 값 하나가 가용성·비용을 바로 바꾼다"
    },
    {
      "id": "destructive-shell",
      "grade": "A",
      "applies_to": ".*",
      "pattern": "\\brm\\s+-rf?\\b|git\\s+push\\b.*(--force|-f\\b)|kubectl\\s+(delete|edit)\\b|terraform\\s+(destroy|apply\\s+-auto-approve)|--no-verify",
      "flags": [
        "one_way_door"
      ],
      "reason": "파괴적·가드레일 우회 명령"
    },
    {
      "id": "credential-literal",
      "grade": "A",
      "applies_to": ".*",
      "pattern": "(?i)\\b(password|passwd|secret|token|api[_-]?key|private[_-]?key)\\b\\s*[:=]\\s*[\"']?[A-Za-z0-9/+=_\\-]{12,}",
      "flags": [
        "security"
      ],
      "reason": "리터럴 자격증명 의심: 값이 코드에 들어왔다"
    },
    {
      "id": "auth-bypass",
      "grade": "A",
      "applies_to": "\\.(kt|java|ts|tsx|py|go)$",
      "pattern": "(?i)permitAll|allowAll|@PreAuthorize\\(\\s*\"permitAll|csrf\\(\\)\\.disable|verify\\s*=\\s*False|InsecureSkipVerify\\s*[:=]\\s*true|allowedOrigins?\\s*[:=(]\\s*[\"'\\[]?\\*",
      "flags": [
        "security"
      ],
      "reason": "인가·검증 완화: 넓어져도 테스트는 통과한다"
    },
    {
      "id": "todo-marker",
      "grade": null,
      "applies_to": ".*",
      "pattern": "\\b(TODO|FIXME|HACK|XXX)\\b",
      "flags": [
        "note"
      ],
      "reason": "미완 표식이 머지 대상에 남아 있다"
    }
  ],
  "env_tokens": {
    "prod": [
      "prod",
      "production",
      "live",
      "global"
    ],
    "stg": [
      "stg",
      "staging",
      "stage"
    ],
    "dev": [
      "dev",
      "development"
    ]
  },
  "axis_catalog": {
    "intent": {
      "label": "의도",
      "prompt": "왜 이 변경이 필요했고 왜 지금인가. 없었다면 무엇이 불가능하거나 잘못됐는가"
    },
    "mechanism": {
      "label": "메커니즘",
      "prompt": "바뀐 블록에 무엇이 들어오고 무엇이 나가는가. 그 차이가 어떻게 목적을 달성하는가"
    },
    "verification": {
      "label": "검증",
      "prompt": "머지 후 10분 안에 무엇을 보고 성공을 판정하는가. 실제로 실행할 쿼리나 명령 하나"
    },
    "failure_mode": {
      "label": "실패 양상",
      "prompt": "규칙이 의도보다 넓거나 좁게 적용되면 무엇이 사라지거나 중복되는가. 그것을 어떻게 알아차리는가"
    },
    "blast_radius": {
      "label": "영향 범위",
      "prompt": "어느 환경·서비스·소비자가 이 변경을 받는가. 받지 않아야 하는데 받는 곳은 없는가"
    },
    "rollback": {
      "label": "롤백",
      "prompt": "되돌리는 방법과 소요 시간. 되돌려도 남는 것(데이터·상태)은 무엇인가"
    },
    "compatibility": {
      "label": "호환성",
      "prompt": "이 계약 변경으로 깨지는 소비자는 누구이고 배포 순서는 무엇인가"
    },
    "exposure": {
      "label": "노출",
      "prompt": "이 변경으로 새로 열리거나 닫히는 권한·데이터·표면은 무엇인가"
    },
    "alternatives": {
      "label": "기각 대안",
      "prompt": "고려했다가 버린 대안과 그 이유. 같은 대안이 다시 제안되면 무엇으로 막는가"
    },
    "omitted": {
      "label": "의도적 제외",
      "prompt": "일부러 하지 않은 것과 그 이유"
    }
  },
  "axis_selection": {
    "always": [
      "intent",
      "mechanism",
      "verification"
    ],
    "by_flag": {
      "silent_failure": [
        "failure_mode"
      ],
      "prod": [
        "blast_radius",
        "rollback"
      ],
      "runtime": [
        "blast_radius"
      ],
      "one_way_door": [
        "rollback"
      ],
      "contract": [
        "compatibility"
      ],
      "security": [
        "exposure"
      ],
      "decision": [
        "alternatives",
        "omitted"
      ]
    },
    "priority": [
      "intent",
      "mechanism",
      "verification",
      "failure_mode",
      "blast_radius",
      "rollback",
      "compatibility",
      "exposure",
      "alternatives",
      "omitted"
    ],
    "max_questions": 5
  },
  "routine": {
    "_comment": "파일의 추가 라인 전부가 pattern에 맞고 prod env가 아니면 관례 작업으로 본다. 모든 파일이 관례면 PR 등급을 B로 내린다(prod가 하나라도 있으면 유지).",
    "image-bump": {
      "pattern": "^\\s*(tag|image|imageTag|image_tag|newTag)\\s*[:=]\\s*\\S+\\s*$",
      "reason": "비프로드 이미지 태그 승격만 포함: 관례 배포. 파이프라인이 검증 장치"
    }
  }
}