{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "errors", "gaps"],
  "properties": {
    "summary": {"type": "string", "description": "검토한 범위와 자료 품질 총평 2~4문장"},
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "problem", "evidence_url", "evidence_quote"],
        "properties": {
          "claim_id": {"type": "string", "description": "claims.jsonl의 claim_id. notes 요약의 문장이면 'notes:qN'"},
          "problem": {"type": "string", "description": "틀렸거나 과장됐거나 버전이 맞지 않는 이유(한국어)"},
          "evidence_url": {"type": "string"},
          "evidence_quote": {"type": "string", "description": "반증 원문 그대로. 없으면 빈 문자열"}
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subq", "missing", "where_to_look"],
        "properties": {
          "subq": {"type": "string"},
          "missing": {"type": "string", "description": "설계 결정에 필요한데 빠진 사실(한국어)"},
          "where_to_look": {"type": "string", "description": "찾을 곳: 공식 문서 URL, 코드 경로, 검색어"}
        }
      }
    }
  }
}
